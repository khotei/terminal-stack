// Zellij's bar, frames and plugin lists in Ghostty's 16 slots — numbers, never RGB, so
// Ghostty supplies every shade and Zellij owns no palette. The two halves only swap
// which slot is the fill and which the text: light fills with 15 and writes with 0,
// dark the reverse, so text on a fill (tabs, selected rows) always takes the fill's
// opposite. That needs a true light 15 and dark 0, which ghostty/themes/ provides.
// Slots: 4 accent (focused frame, active tab) · 8 idle tab / selected row · 1 2 3 5
// red green yellow purple. `background 0` on frames/tables/exit codes is upstream's
// "no fill" convention, as in the built-in `ansi` theme.
// Auto-loaded: ~/.config/zellij symlinks to zellij/, and themes/ is Zellij's default
// theme_dir. Selected by theme_light/theme_dark in ../config.kdl.

themes {
    terminal-light {
        text_unselected {
            base 0
            background 15
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        text_selected {
            base 15
            background 8
            emphasis_0 15
            emphasis_1 15
            emphasis_2 15
            emphasis_3 15
        }
        ribbon_unselected {
            base 15
            background 8
            emphasis_0 15
            emphasis_1 15
            emphasis_2 15
            emphasis_3 15
        }
        ribbon_selected {
            base 15
            background 4
            emphasis_0 15
            emphasis_1 15
            emphasis_2 15
            emphasis_3 15
        }
        table_title {
            base 4
            background 0
            emphasis_0 1
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        table_cell_unselected {
            base 0
            background 15
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        table_cell_selected {
            base 15
            background 8
            emphasis_0 15
            emphasis_1 15
            emphasis_2 15
            emphasis_3 15
        }
        list_unselected {
            base 0
            background 15
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        list_selected {
            base 15
            background 8
            emphasis_0 15
            emphasis_1 15
            emphasis_2 15
            emphasis_3 15
        }
        frame_unselected {
            base 8
            background 0
            emphasis_0 4
            emphasis_1 2
            emphasis_2 5
            emphasis_3 0
        }
        frame_selected {
            base 4
            background 0
            emphasis_0 1
            emphasis_1 2
            emphasis_2 5
            emphasis_3 0
        }
        frame_highlight {
            base 1
            background 0
            emphasis_0 5
            emphasis_1 1
            emphasis_2 1
            emphasis_3 1
        }
        exit_code_success {
            base 2
            background 0
            emphasis_0 4
            emphasis_1 0
            emphasis_2 5
            emphasis_3 3
        }
        exit_code_error {
            base 1
            background 0
            emphasis_0 3
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 5
            player_2 4
            player_3 0
            player_4 3
            player_5 6
            player_6 0
            player_7 1
            player_8 0
            player_9 0
            player_10 0
        }
    }
    terminal-dark {
        text_unselected {
            base 15
            background 0
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        text_selected {
            base 0
            background 8
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        ribbon_unselected {
            base 0
            background 8
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        ribbon_selected {
            base 0
            background 4
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        table_title {
            base 4
            background 0
            emphasis_0 1
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        table_cell_unselected {
            base 15
            background 0
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        table_cell_selected {
            base 0
            background 8
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        list_unselected {
            base 15
            background 0
            emphasis_0 4
            emphasis_1 2
            emphasis_2 3
            emphasis_3 5
        }
        list_selected {
            base 0
            background 8
            emphasis_0 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        frame_unselected {
            base 8
            background 0
            emphasis_0 4
            emphasis_1 2
            emphasis_2 5
            emphasis_3 0
        }
        frame_selected {
            base 4
            background 0
            emphasis_0 1
            emphasis_1 2
            emphasis_2 5
            emphasis_3 0
        }
        frame_highlight {
            base 1
            background 0
            emphasis_0 5
            emphasis_1 1
            emphasis_2 1
            emphasis_3 1
        }
        exit_code_success {
            base 2
            background 0
            emphasis_0 4
            emphasis_1 15
            emphasis_2 5
            emphasis_3 3
        }
        exit_code_error {
            base 1
            background 0
            emphasis_0 3
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 5
            player_2 4
            player_3 0
            player_4 3
            player_5 6
            player_6 0
            player_7 1
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
