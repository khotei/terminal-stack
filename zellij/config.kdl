// Zellij — multiplexer layer of terminal-stack
// Installs to ~/.config/zellij/config.kdl
// Reference + keybinding cheatsheet: ./README.md · upstream: https://zellij.dev/documentation
// Validate: `zellij --config zellij/config.kdl setup --check` (run by /check + CI)

// ── options ───────────────────────────────────────────────────────────
// Slot numbers from ./themes/terminal.kdl, so the bar takes Ghostty's palette; Zellij
// swaps the pair live when Ghostty reports the appearance over CSI 2031 (zellij ≥ 0.44.2).
// `theme` is only the pre-handshake fallback.
theme "terminal-light"
theme_light "terminal-light"
theme_dark "terminal-dark"
default_layout "compact-top"    // ./layouts/compact-top.kdl — built-in compact with the bar on top
pane_frames true                // on so the rounded corners below can draw; frame = 1-cell content breathing room
copy_on_select true             // select = copy, tmux-like
scrollback_editor "nvim"        // `Edit scrollback` opens in the stack's editor
mouse_mode true

// ── UI ────────────────────────────────────────────────────────────────
ui {
    pane_frames {
        rounded_corners true    // inert unless pane_frames true above
    }
}

// ── keybinds: native modal, manual lock ───────────────────────────────
// Native modal Zellij (Ctrl+t tab · Ctrl+s scroll · Ctrl+; pane; Pane/Move/Session/Resize
// also behind Ctrl+t p/m/o/R), no tmux prefix. Nested apps do NOT auto-lock —
// you hold the lock yourself, by choice (no zellij-autolock plugin):
//   · Ctrl+q toggles Locked ⇄ Normal — the single manual switch, kept on the
//     same Ctrl modifier as every other action so the hand never swaps to Alt
//     mid-flow. In Locked, Zellij hands the pane every key, so Claude Code's
//     Ctrl+t/r reach the app instead of a Zellij mode; Ctrl+q
//     again takes the multiplexer back. GOTCHA: enter nvim / claude and their
//     Ctrl-keys are eaten until you Ctrl+q — no auto-locking.
//     Ctrl+q, not Ctrl+Space (macOS eats it for input-source switch) nor the old
//     Alt+d (the Alt-vs-Ctrl modifier hop was the friction). It reclaims the key
//     from Zellij's default Quit — a deliberate keypress nobody makes; the old
//     XON flow-control meaning is already moot since Ctrl+s drives Scroll mode.
//   · unbind Ctrl+g — Locked mode's default unlock; freed so Claude Code's own
//     Ctrl+g (edit prompt in $EDITOR) reaches it. Leave Locked with Ctrl+q.
// Locked mode honours only Ctrl+q, so a way back out is always bound.
keybinds {
    shared_except "locked" {
        unbind "Ctrl g"
        // Freed for the apps even when unlocked — each is daily vocabulary inside
        // a pane: Ctrl+p/n nvim completion-prev/next (+ Claude Code list up/down)
        // · Ctrl+h nvim window-left · Ctrl+o nvim jumplist-back + Claude Code
        // transcript. Their modes re-enter via the tab hub below.
        unbind "Ctrl p"
        unbind "Ctrl h"
        unbind "Ctrl o"
        unbind "Ctrl n"
        bind "Ctrl q" { SwitchToMode "Locked"; }
    }
    locked {
        unbind "Ctrl g"
        bind "Ctrl q" { SwitchToMode "Normal"; }
    }
    // The tab hub: every other mode rides behind Ctrl+t instead of owning a
    // global Ctrl key — every Ctrl letter left collides with nvim, the shell or
    // Claude Code; Ctrl+\ was rejected (in Locked it reaches the shell as
    // SIGQUIT). R, not r — lowercase r is tab-mode's rename.
    tab {
        bind "p" { SwitchToMode "Pane"; }
        bind "m" { SwitchToMode "Move"; }
        bind "o" { SwitchToMode "Session"; }
        bind "R" { SwitchToMode "Resize"; }
    }
    // Pane gets one direct key, Ctrl+; — punctuation, so free in nvim, zsh and
    // Claude Code, unlike every Ctrl letter. Not Ctrl+] — nvim's go-to-definition.
    // GOTCHA: legacy terminal encoding can't send Ctrl+;, it arrives only over
    // the kitty keyboard protocol (Ghostty ⇄ Zellij). Pane's own r is split-right,
    // hence R for Resize, as in the tab hub.
    shared_except "locked" "pane" {
        bind "Ctrl ;" { SwitchToMode "Pane"; }
    }
    pane {
        bind "Ctrl ;" { SwitchToMode "Normal"; }
        bind "m" { SwitchToMode "Move"; }
        bind "R" { SwitchToMode "Resize"; }
    }
    // choose-tree (Ctrl+t o f) — tmux `choose-tree` analog: a fuzzy tree of
    // sessions→tabs→panes where 1-9/A-Z jump straight to one. Picked over the
    // built-in session-manager (Ctrl+t o w), which can't drill to pane level. The wasm
    // is fetched into plugins/ by install.sh (git-ignored, best-effort — Ctrl+t o f is a
    // no-op if absent). floating+move_to_focused_tab mirror the session-manager bind.
    // https://github.com/laperlej/zellij-choose-tree
    session {
        bind "f" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij-choose-tree.wasm" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "Normal"
        }
    }
}

