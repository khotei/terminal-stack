{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh pr list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ghostty +show-config*)",
      "Bash(zellij setup*)",
      "Bash(nvim --headless*)",
      "Bash(zsh -n*)",
      "Bash(stylua*)",
      "Bash(shfmt*)",
      "Bash(brew *)",
      "Bash(make *)",
      "Bash(docker build*)",
      "Bash(docker run*)",
      "Bash(docker image*)",
      "Bash(bash scripts/check.sh*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git branch *)",
      "Bash(git rebase*)",
      "Bash(git reset *)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(find *-delete*)",
      "Bash(find *-exec*)",
      "Bash(fd *--exec*)",
      "Bash(fd *-x *)",
      "Bash(fd *-X *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(pnpm *)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": false
  }
}
